# AI Predictive Maintenance - Backend Environment Variables
# Copy this file to .env and configure your secrets.

# ---------- PostgreSQL (Render / Cloud or Local) ----------
# On Render: Set DATABASE_URL provided by Render PostgreSQL
# Example: postgres://user:password@dpg-xxxx.render.com/dbname
DATABASE_URL=

# Alternatively, for local PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=maintenance
DB_USER=postgres
DB_PASSWORD=

# ---------- Email Alerts (SMTP) ----------
# For Gmail: Use an App Password (16 chars) from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com

# Comma-separated list of alert recipients
ALERT_RECIPIENTS=maintenance-lead@example.com,engineer@example.com

# Minimum cooldown window (minutes) before re-alerting on the same machine
ALERT_COOLDOWN_MINUTES=15

# Risk threshold % (0-100) that triggers an alert email
ALERT_RISK_THRESHOLD=60

# Set to "false" to disable sending emails (useful for testing/demo)
EMAIL_ALERTS_ENABLED=true

# ---------- Monitored Machines ----------
MONITORED_MACHINES=M01,M02,M03

# ---------- CORS Origins ----------
# Comma-separated allowed frontend origins (or * for all)
CORS_ORIGINS=*
